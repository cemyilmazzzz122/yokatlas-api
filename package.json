{
  "name": "yokatlas-api-wrapper",
  "version": "1.1.0",
  "description": "YÖK Atlas tercih kılavuzu JSON API'si için Node.js sarmalayıcı ve MCP sunucusu (unofficial)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "yokatlas": "./dist/cli.js",
    "yokatlas-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --clean --shims",
    "dev": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --watch --shims",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "yokatlas",
    "yok-atlas",
    "tercih",
    "tercih-kilavuzu",
    "universite",
    "api",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cli",
    "turkish",
    "turkce"
  ],
  "author": "Cem",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
